{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    13
  ],
  "preview": "layouts/artemis.svg",
  "theme": "graphite",
  "colors": {
    "canvas": "#030304",
    "background": "#0e162133",
    "chrome": "#00000000",
    "surface": "#00000000",
    "popover": "#0a1017",
    "raised": "#0d141c",
    "hover": "#ffffff0d",
    "selected": "#ffffff14",
    "border": "#ffffff1f",
    "input": "#0c131a",
    "foreground": "#e7ecf3",
    "muted": "#b7c2cd",
    "dim": "#828d9c",
    "accent": "#e9d8b9",
    "accent_foreground": "#0a0c11",
    "solid": "#111820",
    "solid_foreground": "#0a0f15",
    "selection": "#2a3a4d66",
    "working": "#8bb3d9",
    "blocked": "#e08a6c",
    "done": "#d8c8a6",
    "idle": "#5f6a78",
    "unknown": "#47525f",
    "ansi0": "#121821",
    "ansi1": "#dd7a63",
    "ansi2": "#a3bd97",
    "ansi3": "#e3c88d",
    "ansi4": "#7fa6cf",
    "ansi5": "#c39ecf",
    "ansi6": "#83bfc0",
    "ansi7": "#c9d2dc",
    "ansi8": "#3b4655",
    "ansi9": "#ef9781",
    "ansi10": "#bcd4ab",
    "ansi11": "#f2dba3",
    "ansi12": "#9cc0e6",
    "ansi13": "#d8b5e2",
    "ansi14": "#9ed8d6",
    "ansi15": "#edf2f7"
  },
  "background": {
    "image": "backgrounds/artemis.jpg",
    "fit": "contain"
  },
  "padding": 14,
  "gap": 10,
  "terminal_padding": [
    20,
    24
  ],
  "terminal_opacity": 0,
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": {
        "px": 38
      },
      "window_drag": true,
      "content": {
        "mod": "artemis-bar"
      }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 10,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 292
          },
          "min": 220,
          "max": 420,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "artemis-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ],
          "background": "#070b1240",
          "border": {
            "width": 1,
            "color": "#ffffff1f"
          },
          "radius": 14
        },
        {
          "id": "work",
          "type": "column",
          "gap": 10,
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 38
              },
              "window_drag": true,
              "content": {
                "mod": "artemis-tabs"
              },
              "background": "#070b1240",
              "border": {
                "width": 1,
                "color": "#ffffff1f"
              },
              "radius": 12
            },
            {
              "id": "work-body",
              "type": "row",
              "gap": 10,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 10,
                      "background": "#0e162152",
                      "radius": 14,
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "#ffffff1f"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "artemis-pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 340
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ],
                  "background": "#070b1240",
                  "border": {
                    "width": 1,
                    "color": "#ffffff1f"
                  },
                  "radius": 14
                }
              ]
            }
          ]
        }
      ],
      "size": {
        "weight": 1
      }
    },
    {
      "id": "status",
      "type": "row",
      "size": {
        "px": 26
      },
      "gap": 0,
      "resizable": false,
      "background": "#070b1240",
      "border": {
        "width": 1,
        "color": "#ffffff1f"
      },
      "radius": 10,
      "children": [
        {
          "id": "status-workspace",
          "type": "block",
          "size": {
            "weight": 1
          },
          "content": {
            "mod": "artemis-workspace-status"
          }
        },
        {
          "id": "status-sysmon",
          "type": "block",
          "size": {
            "px": 512
          },
          "min": 512,
          "content": {
            "mod": "sysmon"
          }
        }
      ]
    }
  ]
}
