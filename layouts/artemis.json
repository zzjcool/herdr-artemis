{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    13
  ],
  "preview": "layouts/artemis.svg",
  "theme": {
    "light": "artemis-light",
    "dark": "artemis-dark"
  },
  "background": {
    "image": "backgrounds/artemis.jpg",
    "fit": "contain"
  },
  "padding": 0,
  "gap": 0,
  "terminal_padding": [
    20,
    24
  ],
  "terminal_opacity": 0,
  "children": [
    {
      "id": "shell",
      "type": "column",
      "gap": 10,
      "size": { "weight": 1 },
      "background": "background",
      "children": [
        {
          "id": "body",
          "type": "row",
          "gap": 10,
          "children": [
            {
              "id": "sidebar",
              "type": "column",
              "size": {
                "px": 292
              },
              "min": 220,
              "max": 420,
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "artemis-spaces"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "artemis-agents"
                  }
                }
              ],
              "background": "surface",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "work",
              "type": "column",
              "gap": 10,
              "resizable": false,
              "children": [
                {
                  "id": "tabs",
                  "type": "block",
                  "size": {
                    "px": 38
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "artemis-tabs"
                  },
                  "background": "surface",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 12
                },
                {
                  "id": "work-body",
                  "type": "row",
                  "gap": 10,
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "gap": 10,
                          "background": "input",
                          "radius": 14,
                          "lone": true,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "header": {
                            "content": {
                              "mod": "artemis-pane"
                            },
                            "height": 30,
                            "position": "top",
                            "reveal": "always"
                          }
                        }
                      }
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "hidden": true,
                      "size": {
                        "px": 340
                      },
                      "min": 280,
                      "max": 900,
                      "children": [
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "active": "files",
                          "children": [
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "artemis-files"
                              }
                            },
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "changes"
                              }
                            }
                          ]
                        }
                      ],
                      "background": "surface",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 14
                    }
                  ]
                }
              ]
            }
          ],
          "size": {
            "weight": 1
          }
        },
        {
          "id": "status",
          "type": "row",
          "size": {
            "px": 26
          },
          "gap": 0,
          "resizable": false,
          "background": "surface",
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 10,
          "children": [
            {
              "id": "status-workspace",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "artemis-workspace-status"
              }
            },
            {
              "id": "status-sysmon",
              "type": "block",
              "size": {
                "px": 480
              },
              "min": 480,
              "content": {
                "mod": "sysmon"
              }
            }
          ]
        }
      ]
    }
  ],
  "terminal_menu": "artemis-menu"
}
