{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    13
  ],
  "preview": "layouts/artemis.svg",
  "theme": "graphite",
  "colors": {
    "canvas": "#04060b",
    "background": "#060a11f2",
    "chrome": "#080d14d0",
    "surface": "#070b12f2",
    "popover": "#0b1018",
    "raised": "#111a24",
    "hover": "#ffffff14",
    "selected": "#ffffff1f",
    "border": "#ffffff24",
    "input": "#28313f",
    "foreground": "#e7ecf3",
    "muted": "#b7c2cd",
    "dim": "#828d9c",
    "accent": "#e9d8b9",
    "accent_foreground": "#0a0c11",
    "solid": "#e9d8b9",
    "solid_foreground": "#0a0c11",
    "selection": "#2a3a4d66",
    "working": "#8bb3d9",
    "blocked": "#e08a6c",
    "done": "#d8c8a6",
    "idle": "#5f6a78",
    "unknown": "#47525f",
    "ansi0": "#121821",
    "ansi1": "#dd7a63",
    "ansi2": "#a3bd97",
    "ansi3": "#e3c88d",
    "ansi4": "#7fa6cf",
    "ansi5": "#c39ecf",
    "ansi6": "#83bfc0",
    "ansi7": "#c9d2dc",
    "ansi8": "#3b4655",
    "ansi9": "#ef9781",
    "ansi10": "#bcd4ab",
    "ansi11": "#f2dba3",
    "ansi12": "#9cc0e6",
    "ansi13": "#d8b5e2",
    "ansi14": "#9ed8d6",
    "ansi15": "#edf2f7"
  },
  "background": {
    "image": "mods/artemis-head/sky.jpg",
    "fit": "cover"
  },
  "padding": [
    28,
    0
  ],
  "gap": 0,
  "terminal_padding": [
    14,
    17
  ],
  "terminal_opacity": 1,
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": {
        "px": 38
      },
      "window_drag": true,
      "content": {
        "mod": "artemis-bar"
      }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 0,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 292
          },
          "min": 220,
          "max": 420,
          "children": [
            {
              "id": "plate",
              "type": "block",
              "size": {
                "px": 400
              },
              "content": {
                "mod": "artemis-head"
              },
              "background": {
                "image": "mods/artemis-head/rail.jpg",
                "fit": "cover"
              }
            },
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "gap": 12,
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 38
              },
              "window_drag": true,
              "background": "chrome",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 12,
              "shadow": "sm",
              "content": {
                "mod": "tabs"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "gap": 10,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 10,
                      "radius": 14,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "shadow": "lg",
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 340
                  },
                  "min": 280,
                  "max": 900,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 14,
                  "shadow": "lg",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "status",
              "type": "block",
              "size": {
                "px": 26
              },
              "content": {
                "mod": "workspace-status"
              },
              "background": "chrome",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 10,
              "shadow": "sm"
            }
          ],
          "padding": [
            10,
            20
          ]
        }
      ]
    }
  ]
}