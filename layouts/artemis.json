{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    11
  ],
  "preview": "layouts/artemis.svg",
  "theme": "graphite",
  "colors": {
    "canvas": "#04060a",
    "background": "#05070cf7",
    "chrome": "#080b11",
    "surface": "#0a0e15",
    "popover": "#0b1018",
    "raised": "#121a24",
    "hover": "#16202c",
    "selected": "#1d2836",
    "border": "#1c2532",
    "input": "#28313f",
    "foreground": "#e6ebf2",
    "muted": "#9aa6b4",
    "dim": "#5f6a78",
    "accent": "#e9d8b9",
    "accent_foreground": "#0a0c11",
    "solid": "#e9d8b9",
    "solid_foreground": "#0a0c11",
    "selection": "#2a3a4d66",
    "working": "#8bb3d9",
    "blocked": "#e08a6c",
    "done": "#d8c8a6",
    "idle": "#5f6a78",
    "unknown": "#47525f",
    "ansi0": "#121821",
    "ansi1": "#dd7a63",
    "ansi2": "#a3bd97",
    "ansi3": "#e3c88d",
    "ansi4": "#7fa6cf",
    "ansi5": "#c39ecf",
    "ansi6": "#83bfc0",
    "ansi7": "#c9d2dc",
    "ansi8": "#3b4655",
    "ansi9": "#ef9781",
    "ansi10": "#bcd4ab",
    "ansi11": "#f2dba3",
    "ansi12": "#9cc0e6",
    "ansi13": "#d8b5e2",
    "ansi14": "#9ed8d6",
    "ansi15": "#edf2f7"
  },
  "background": {
    "gradient": [
      "#080b12",
      "#0a0908"
    ],
    "angle": 168
  },
  "terminal_padding": [
    14,
    18
  ],
  "divider": {
    "width": 1,
    "color": "#ffffff0f"
  },
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": {
        "px": 38
      },
      "window_drag": true,
      "content": {
        "mod": "artemis-bar"
      }
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "#ffffff0f"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 292
          },
          "min": 220,
          "max": 420,
          "divider": {
            "width": 1,
            "color": "#ffffff0f"
          },
          "children": [
            {
              "id": "plate",
              "type": "block",
              "size": {
                "px": 132
              },
              "content": {
                "mod": "artemis-head"
              }
            },
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ],
          "background": {
            "gradient": [
              "#0c121a",
              "#080b11"
            ],
            "angle": 180
          }
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 38
              },
              "content": {
                "mod": "tabs"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "padding": 12,
              "gap": 10,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 10,
                      "radius": 8,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 28,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 340
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "status",
              "type": "block",
              "size": {
                "px": 26
              },
              "content": {
                "mod": "workspace-status"
              }
            }
          ]
        }
      ]
    }
  ]
}
